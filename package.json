{
  "name": "@knorby/inkeedecoder-mcp",
  "version": "0.1.0",
  "description": "MCP server for INKEEDecoder (formerly INCIDecoder) cosmetic ingredient and product data — search products and ingredients, read ingredient profiles, and resolve incidecoder.com links.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inkeedecoder",
    "incidecoder",
    "cosmetics",
    "skincare",
    "ingredients",
    "inci"
  ],
  "homepage": "https://github.com/knorby/inkeedecoder-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knorby/inkeedecoder-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/knorby/inkeedecoder-mcp/issues"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "inkeedecoder-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsx watch src/index.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "biome check --write",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "inspect": "mcp-inspector --config inspector.config.json",
    "inspect:cli": "mcp-inspector --cli --config inspector.config.json --server local --method tools/list",
    "test:smoke": "mcp-inspector --cli --config inspector.config.json --server local --method tools/list",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@knorby/inkeedecoder-client": "^0.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/inspector": "^2.12.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
