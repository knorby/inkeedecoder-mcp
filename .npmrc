# Block dependency postinstall scripts by default (supply-chain security).
# Note: this also blocks this repo's own `prepare` script, so `npm install`
# will NOT auto-set-up Husky hooks. Run `npx husky` after `npm install`, or
# use `npm install --ignore-scripts=false` to allow the prepare script.
# Override with `npm install --ignore-scripts=false` only when you trust the
# package.
ignore-scripts=true
